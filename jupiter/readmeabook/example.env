# Komodo stack variables. Generate independent secrets; do not reuse examples.
TZ=Etc/UTC
PUID=1000
PGID=1000
UMASK=002

PG_USER=readmeabook
# Use a URL-safe value because the stack inserts this into DATABASE_URL.
# Generate one with: openssl rand -hex 32
PG_PASS=replace-with-a-url-safe-random-password
PG_DB=readmeabook

JWT_SECRET=replace-with-a-random-secret
JWT_REFRESH_SECRET=replace-with-another-random-secret
CONFIG_ENCRYPTION_KEY=replace-with-a-32-byte-encryption-key
# Required for OIDC; use the external HTTPS origin without a trailing slash.
PUBLIC_URL=https://readmeabook.example.com

# Keep local login enabled until OIDC login and administrator access are tested.
DISABLE_LOCAL_LOGIN=false
LOG_LEVEL=info

READMEABOOK_MEM_LIMIT=2g
READMEABOOK_DATABASE_MEM_LIMIT=1g
READMEABOOK_VALKEY_MEM_LIMIT=512m
