{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "assignAutomerge": false,
  "assignees": [
    "emanuelsipos"
  ],
  "labels": [
    "renovate"
  ],
  "configMigration": true,
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "groupName": "immich",
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-machine-learning",
        "ghcr.io/immich-app/immich-server"
      ]
    },
    {
      "groupName": "forgejo",
      "matchPackageNames": [
        "data.forgejo.org/**"
      ]
    },
    {
      "groupName": "remnawave",
      "matchPackageNames": [
        "remnawave/*"
      ]
    },
    {
      "groupName": "fosrl",
      "matchPackageNames": [
        "fosrl/*"
      ]
    },
    {
      "groupName": "ente",
      "matchPackageNames": [
        "ghcr.io/ente/*"
      ]
    },
    {
      "groupName": "simplelogin",
      "matchPackageNames": [
        "simplelogin/*"
      ]
    },
    {
      "groupName": "soju",
      "matchPackageNames": [
        "codeberg.org/emersion/*"
      ]
    },
    {
      "groupName": "librechat",
      "matchPackageNames": [
        "ghcr.io/danny-avila/librechat*"
      ]
    },
    {
      "groupName": "profilarr",
      "matchPackageNames": [
        "ghcr.io/dictionarry-hub/*"
      ]
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "/(.*/)?postgres$/",
        "/(.*/)?mariadb$/",
        "/(.*/)?mongo$/",
        "/(.*/)?redis$/",
        "/(.*/)?valkey$/"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "/(.*/)?postgres$/",
        "/(.*/)?mariadb$/",
        "/(.*/)?mongo$/",
        "/(.*/)?redis$/",
        "/(.*/)?valkey$/"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-machine-learning",
        "ghcr.io/immich-app/immich-server"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "ghcr.io/esphome/esphome",
        "ghcr.io/goauthentik/server",
        "cloudflare/cloudflared",
        "revenz/fileflows",
        "ghcr.io/home-assistant/home-assistant",
        "chromedp/headless-shell",
        "ghcr.io/karakeep-app/karakeep-chrome",
        "wangqiru/ttrss",
        "diygod/rsshub"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchPackageNames": [
        "ghcr.io/qbittorrent/docker-qbittorrent-nox"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "anonaddy/anonaddy",
        "certbot/dns-cloudflare",
        "favonia/cloudflare-ddns",
        "crowdsecurity/crowdsec",
        "tiredofit/db-backup",
        "nginx",
        "simplelogin/app-ci",
        "simplelogin/postfix",
        "ghcr.io/bakito/adguardhome-sync",
        "ghcr.io/moghtech/komodo-core",
        "ghcr.io/ente/server",
        "ghcr.io/ente/web",
        "adguard/adguardhome",
        "fosrl/pangolin",
        "fosrl/gerbil",
        "traefik",
        "mvance/unbound",
        "louislam/uptime-kuma",
        "vaultwarden/server",
        "ghcr.io/advplyr/audiobookshelf",
        "alpine/git",
        "lscr.io/linuxserver/bazarr",
        "ghcr.io/dgtlmoon/changedetection.io",
        "dgtlmoon/sockpuppetbrowser",
        "data.forgejo.org/oci/docker",
        "data.forgejo.org/forgejo/runner",
        "data.forgejo.org/forgejo/forgejo",
        "ghcr.io/blakeblackshear/frigate",
        "ghcr.io/karakeep-app/karakeep",
        "lscr.io/linuxserver/kavita",
        "sndxr/komf",
        "gotson/komga",
        "ghcr.io/danny-avila/librechat",
        "ghcr.io/danny-avila/librechat-rag-api-dev-lite",
        "ghcr.io/thephaseless/byparr",
        "lscr.io/linuxserver/prowlarr",
        "qmcgaw/gluetun",
        "tmmrtn/mousehole",
        "ghcr.io/open-webui/open-webui",
        "lscr.io/linuxserver/plex",
        "lscr.io/linuxserver/radarr",
        "semaphoreui/semaphore",
        "codeberg.org/emersion/gamja",
        "codeberg.org/emersion/kimchi",
        "codeberg.org/emersion/soju",
        "lscr.io/linuxserver/sonarr",
        "ghcr.io/suwayomi/suwayomi-server",
        "lscr.io/linuxserver/tautulli",
        "ghcr.io/games-on-whales/wolf",
        "lscr.io/linuxserver/syncthing",
        "filebrowser/filebrowser",
        "ghcr.io/immich-app/immich-machine-learning",
        "ghcr.io/immich-app/immich-server",
        "remnawave/*",
        "mbentley/omada-controller",
        "henrygd/beszel",
        "eclipse-mosquitto",
        "ghcr.io/koenkk/zigbee2mqtt",
        "ghcr.io/stuffanthings/qbit_manage",
        "ghcr.io/autobrr/qui",
        "fosrl/newt",
        "lscr.io/linuxserver/beets",
        "ghcr.io/music-assistant/server",
        "stashapp/stash",
        "ghcr.io/rustic-rs/rustic",
        "chaptarr/chaptarr",
        "basqpcez/mam-point-spender",
        "mcuadros/ofelia",
        "ghcr.io/matter-js/python-matter-server",
        "ghcr.io/maintainerr/maintainerr",
        "ghcr.io/mealie-recipes/mealie",
        "erikvl87/languagetool",
        "pgautoupgrade/pgautoupgrade",
        "healthchecks/healthchecks",
        "ghcr.io/tphakala/birdnet-go",
        "ghcr.io/seerr-team/seerr",
        "myoung34/github-runner",
        "luligu/matterbridge",
        "ghcr.io/dictionarry-hub/profilarr",
        "ghcr.io/dictionarry-hub/profilarr-parser",
        "tecnativa/docker-socket-proxy",
        "slskd/slskd",
        "/(.*/)?meilisearch$/",
        "mickey3721/flareproxy",
        "pgvector/pgvector",
        "wangqiru/mercury-parser-api",
        "wangqiru/opencc-api-server"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "docker-compose"
      ],
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchPackageNames": "lscr.io/linuxserver/tautulli",
      "allowedVersions": "<2000"
    },
    {
      "matchPackageNames": "lscr.io/linuxserver/beets",
      "allowedVersions": "<2000"
    },
    {
      "matchPackageNames": "mcuadros/ofelia",
      "allowedVersions": "<3"
    },
    {
      "matchPackageNames": "erikvl87/languagetool",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(-dockerupdate-(?<patch>\\d+))?$"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/tphakala/birdnet-go"
      ],
      "versioning": "regex:^(?<major>\\d{4})(?<minor>\\d{2})(?<patch>\\d{2})$"
    },
    {
      "groupName": "kics",
      "matchManagers": [
        "custom.regex"
      ],
      "matchDepNames": [
        "Checkmarx/kics",
        "Checkmarx/kics (linux_amd64 archive)"
      ],
      "minimumGroupSize": 3
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "addLabels": [
        "pins"
      ],
      "automerge": true,
      "automergeType": "pr"
    }
  ],
  "hostRules": [
    {
      "matchHost": "docker.io",
      "concurrentRequestLimit": 2
    }
  ],
  "docker-compose": {
    "managerFilePatterns": [
      "/^_common/base\\.yaml$/",
      "/^jupiter/qbittorrent/gluetun\\.yaml$/"
    ]
  },
  "customDatasources": {
    "kics-linux-amd64": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/Checkmarx/kics/releases?per_page=100",
      "format": "json",
      "transformTemplates": [
        "($releases := $map($, function($r) { ($v := $replace($r.tag_name, /^v/, \"\"); $a := $r.assets[name = \"kics_\" & $v & \"_linux_amd64.tar.gz\"][0]; $match($a.digest, /^sha256:[a-f0-9]{64}$/) ? {\"version\": $v, \"digest\": $replace($a.digest, /^sha256:/, \"\"), \"releaseTimestamp\": $r.published_at}) }); {\"releases\": [$filter($releases, function($r) { $exists($r) })]})"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/scripts/security_scan\\.py$/"
      ],
      "matchStrings": [
        "KICS_VERSION = \"(?<currentValue>[^\"]+)\"\\nKICS_ARCHIVE_SHA256 = \"(?<currentDigest>[a-f0-9]{64})\""
      ],
      "depNameTemplate": "Checkmarx/kics (linux_amd64 archive)",
      "datasourceTemplate": "custom.kics-linux-amd64",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/security-scan\\.yml$/"
      ],
      "matchStrings": [
        "ref: (?<currentDigest>[a-f0-9]{40}) # v(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "Checkmarx/kics",
      "packageNameTemplate": "Checkmarx/kics",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": [
        "- dclint@(?<currentValue>[^\\s]+)"
      ],
      "depNameTemplate": "dclint",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
